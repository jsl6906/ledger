# ---- Database (Azure Postgres Flexible Server, Entra auth via service principal) ----
DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=personal_storage
DB_SCHEMA=personal_finances
# Postgres role name of the Entra principal (the service principal's display name)
DB_USER=ledger-app
DB_AUTH_MODE=entra
DB_SSL=require
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Local dev Postgres instead (docker compose -f docker-compose.dev.yml up -d):
# DB_HOST=localhost
# DB_PORT=55432
# DB_USER=ledger
# DB_AUTH_MODE=password
# DB_PASSWORD=ledger
# DB_SSL=disable

# ---- App login ----
# Generate with: cd backend; uv run ledger hash-password
# Keep the single quotes: docker compose would otherwise expand the '$' signs inside the hash.
APP_PASSWORD_HASH=''
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (at least 32 characters; required)
SESSION_SECRET=
# Set true when served over HTTPS (e.g. tailscale serve)
COOKIE_SECURE=false

# ---- AI ----
GEMINI_KEY=
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_REASONING=gemini-3.1-pro-preview

# ---- Runtime ----
JOB_CONCURRENCY=2
LEDGER_PORT=8470
# Nightly checks (anomaly detection) run at NIGHTLY_HOUR:15 in TIMEZONE
TIMEZONE=America/New_York
NIGHTLY_HOUR=3
# Default large-transaction level; the Alerts page setting overrides it
LARGE_TXN_THRESHOLD=500

# ---- Email alerts (SMTP relay; recipients are managed on the Alerts page) ----
# e.g. Gmail: smtp.gmail.com, 587, starttls, your address + an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Weekly digest is sent at 07:00 on this day (mon..sun)
DIGEST_WEEKDAY=mon
# Base URL for links in emails, e.g. http://homeserver:8470
APP_BASE_URL=

# ---- Data sources ----
# Tiller: Google service account key (enable the Sheets API; share the Tiller sheet with its client_email as Viewer).
# In Docker, place the key in ./secrets/ (mounted read-only at /secrets).
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google-sa.json
# ...or paste the whole JSON key on one line instead:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# SimpleFIN is connected from the Sources page; its access key is stored encrypted with SESSION_SECRET
# (changing SESSION_SECRET means reconnecting SimpleFIN).
# Home value estimates for assets set to RentCast (free tier: 50 lookups/month; homes refresh monthly).
RENTCAST_API_KEY=

# ---- Historical backfill ----
# Google Drive: share the archive folder with the service account and pick it on the Sources page.
# Local folder instead: mount it at /inbox (host path below) and set INBOX_DIR.
INBOX_DIR=/inbox
INBOX_HOST_DIR=./inbox
